# ─────────────────────────────────────────────────────────────
# NACRE — environment variables
#
# Copy to .env.local for development. Never commit real secrets.
# Every variable below is read on the server only; none of them
# is prefixed NEXT_PUBLIC_ except the app URL, which is not secret.
# ─────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────
# true  → Google Calendar and WhatsApp are simulated and logged.
# false → live providers are used, if their credentials are complete.
# Defaults to true when unset, so a missing variable can never cause
# real calendar events or real messages to be sent by accident.
DEMO_MODE=true

# Absolute URL of the deployment. Used to build patient management links.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL if omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Database ─────────────────────────────────────────────────
# Leave empty to run the in-memory demo store (zero configuration).
# Set it to switch to PostgreSQL; apply db/schema.sql first.
# Supabase: Project settings → Database → Connection string (URI).
# Neon:     Dashboard → Connection details → Pooled connection.
DATABASE_URL=
# Set to false only for a local Postgres without TLS.
DATABASE_SSL=true


# ── Security ─────────────────────────────────────────────────
# HMAC key for patient management links and admin sessions.
# Generate with:  openssl rand -base64 48
# Rotating it invalidates every existing management link and session.
BOOKING_TOKEN_SECRET=

# Password for /dashboard. Demo default is "nacre-demo".
# Set a strong value before any real deployment.
ADMIN_PASSWORD=
# How long a signed-in staff session lasts, in hours.
ADMIN_SESSION_HOURS=12


# ── Google Calendar ──────────────────────────────────────────
# Service-account authentication. See SETUP.md § Google Cloud.
# The clinic calendar must be shared with GOOGLE_SERVICE_ACCOUNT_EMAIL
# with "Make changes to events" permission.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The full PEM private key. In Vercel, paste it with literal \n escapes:
# "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Only for Google Workspace domain-wide delegation, where the service
# account acts as a named user. Leave empty for a shared calendar.
GOOGLE_CALENDAR_IMPERSONATE_USER=


# ── WhatsApp Cloud API (Meta) ────────────────────────────────
# See SETUP.md § Meta / WhatsApp.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Language code the approved templates were submitted under.
WHATSAPP_TEMPLATE_LANGUAGE=en
# Names of the four approved templates.
WHATSAPP_TEMPLATE_CONFIRMATION=appointment_confirmation
WHATSAPP_TEMPLATE_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_RESCHEDULE=appointment_reschedule
WHATSAPP_TEMPLATE_CANCELLATION=appointment_cancellation


# ── Demo store (optional) ────────────────────────────────────
# Where the in-memory driver persists its snapshot in development.
# Defaults to ./.data locally and /tmp/nacre-demo on Vercel.
DEMO_DATA_DIR=
