# ---------------------------------------------------------------------------
# JAMRA — environment
#
# With NOTHING set, the site runs in demo mode: the seed menu, orders are
# priced but never saved, WhatsApp opens without a number (the visitor picks
# the chat), and /dashboard shows the read-only demo at /dashboard/demo.
# ---------------------------------------------------------------------------

# Public URL, used for canonical/hreflang/Open Graph (no trailing slash).
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used if this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode only: WhatsApp number demo orders are sent to (digits only,
# e.g. 9725XXXXXXXX — a Nexora number you control). Empty: WhatsApp opens
# without a number and the visitor chooses the chat; the "call" button hides.
NEXT_PUBLIC_DEMO_WHATSAPP=

# --- Supabase: all three switch the site to Supabase mode ---------------------
# URL + anon key without the service key is treated as a misconfiguration:
# the menu loads but orders fail loudly instead of silently not saving.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the order server action to call place_order.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED in Supabase mode (orders are refused without it): salt for hashing
# the client IP used by the per-IP rate limit. Long random string.
ORDER_RATE_SALT=

# --- SEO ----------------------------------------------------------------------
# The concept site is noindex by default. Set to true only for a real client.
SITE_INDEXABLE=false
# portfolio (default) or client: client emits Restaurant JSON-LD
SITE_MODE=portfolio
