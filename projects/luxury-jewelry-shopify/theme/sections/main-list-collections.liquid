<div class="page section">
  <header class="coll-intro" style="margin-bottom:var(--s-8)">
    <span class="t-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="t-h1">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}<div class="rte t-lede">{{ section.settings.intro }}</div>{%- endif -%}
  </header>

  <div class="tiles grid grid--3 grid--m1">
    {%- for collection in collections -%}
      <a class="tile{% if settings.enable_reveal %} reveal{% endif %}" data-delay="{{ forloop.index0 | modulo: 3 }}" href="{{ collection.url }}">
        <div class="tile__media">
          {% render 'responsive-image', image: collection.featured_image, alt: collection.title,
             sizes: '(min-width: 750px) 32vw, 92vw', widths: '400,600,800,1000', placeholder: 'collection-1', no_wrapper: true %}
        </div>
        <div class="tile__body">
          <h2 class="tile__title">{{ collection.title }}</h2>
          <p class="tile__text">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The house" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "richtext", "id": "intro", "label": "Intro" }
  ]
}
{% endschema %}
