<footer class="footer">
  <div class="page">
    <div class="footer__top">
      <div class="stack-5">
        <span class="footer__wordmark">{{ settings.wordmark | default: shop.name }}</span>
        {%- if section.settings.newsletter_heading != blank -%}
          <div class="stack">
            <span class="t-eyebrow">{{ section.settings.newsletter_heading }}</span>
            {%- if section.settings.newsletter_text != blank -%}
              <p class="t-meta" style="max-width:38ch">{{ section.settings.newsletter_text }}</p>
            {%- endif -%}
          </div>
          {%- form 'customer', class: 'newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form__success">{{ 'general.newsletter.success' | t }}</p>
            {%- else -%}
              <div class="newsletter__form">
                <label class="visually-hidden" for="footer-email">{{ 'general.newsletter.label' | t }}</label>
                <input
                  class="input"
                  id="footer-email"
                  type="email"
                  name="contact[email]"
                  placeholder="{{ 'general.newsletter.placeholder' | t }}"
                  autocomplete="email"
                  required>
                <button class="newsletter__submit" type="submit">{{ 'general.newsletter.submit' | t }}</button>
              </div>
              {%- if form.errors -%}
                <p class="form__error">{{ form.errors.messages.email }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>

      <div class="footer__cols">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <div {{ block.shopify_attributes }}>
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                <ul class="footer__list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a class="link" href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- when 'text' -%}
              <div {{ block.shopify_attributes }}>
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                <div class="footer__list t-meta">{{ block.settings.text }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}

        <div>
          <h2 class="footer__heading">{{ section.settings.social_heading }}</h2>
          <ul class="footer__list">
            {%- if settings.social_instagram != blank -%}
              <li><a class="link" href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a></li>
            {%- endif -%}
            {%- if settings.social_pinterest != blank -%}
              <li><a class="link" href="{{ settings.social_pinterest }}" rel="noopener" target="_blank">Pinterest</a></li>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <li><a class="link" href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a></li>
            {%- endif -%}
            {%- if section.settings.contact_email != blank -%}
              <li><a class="link" href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></li>
            {%- endif -%}
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_suffix }}</span>
      <div class="footer__legal">
        {%- for link in section.settings.legal_menu.links -%}
          <a class="link" href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
      {%- if settings.concept_disclosure != blank -%}
        <p class="footer__disclosure">{{ settings.concept_disclosure }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "The Letter" },
    { "type": "text", "id": "newsletter_text", "label": "Text", "default": "Occasional notes on new work, stones we have found, and the making of things. No more than eight times a year." },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "social_heading", "label": "Social column heading", "default": "Elsewhere" },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "atelier@cavelier.example" },
    { "type": "header", "content": "Bottom row" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" },
    { "type": "text", "id": "copyright_suffix", "label": "Copyright suffix", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Customer care" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Atelier" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>18 Clerkenwell Green<br>London EC1R 0DP<br>By appointment</p>" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
