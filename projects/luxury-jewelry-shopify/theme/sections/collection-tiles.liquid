{%- liquid
  assign s = section.settings
-%}
<section class="section{% if s.background == 'alabaster' %} section--alabaster{% endif %}" style="--section-y: {{ s.spacing }}px">
  <div class="page">
    {% render 'section-header',
      eyebrow: s.eyebrow,
      heading: s.heading,
      text: s.text,
      link_label: s.link_label,
      link_url: s.link_url,
      align: s.align %}

    <div class="tiles {% if s.layout == 'editorial' %}tiles--editorial{% else %}grid grid--3 grid--m1{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign title = block.settings.heading | default: coll.title
          assign url = block.settings.link | default: coll.url
          assign img = block.settings.image | default: coll.featured_image
          assign tile_alt = block.settings.image_alt | default: title
        -%}
        <a
          class="tile{% if s.caption_style == 'overlay' %} tile--overlay{% endif %}{% if settings.enable_reveal %} reveal{% endif %}"
          data-delay="{{ forloop.index0 | modulo: 3 }}"
          href="{{ url | default: '#' }}"
          {{ block.shopify_attributes }}>
          <div class="tile__media">
            {% render 'responsive-image',
              image: img,
              fallback: block.settings.fallback_image,
              alt: tile_alt,
              sizes: '(min-width: 750px) 42vw, 92vw',
              widths: '400,600,800,1000,1200',
              placeholder: 'collection-1',
              no_wrapper: true %}
          </div>
          <div class="tile__body">
            <h3 class="tile__title">{{ title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="tile__text">{{ block.settings.text }}</p>
            {%- endif -%}
            <span class="link-arrow tile__cta">{{ block.settings.cta | default: 'View' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Begin with the occasion" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "select",
      "id": "align",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" },
        { "value": "split", "label": "Split" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "editorial", "label": "Editorial — asymmetric" },
        { "value": "even", "label": "Even three-up" }
      ],
      "default": "editorial",
      "info": "The editorial layout gives the first tile a tall column and is designed for six tiles."
    },
    {
      "type": "select",
      "id": "caption_style",
      "label": "Caption",
      "options": [
        { "value": "below", "label": "Below the image" },
        { "value": "overlay", "label": "Over the image" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "alabaster", "label": "Alabaster" }
      ],
      "default": "paper"
    },
    { "type": "range", "id": "spacing", "min": 40, "max": 180, "step": 4, "unit": "px", "label": "Section spacing", "default": 112 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "heading", "label": "Title override" },
        { "type": "text", "id": "text", "label": "Caption" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "fallback_image", "label": "Bundled demo image" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "View" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" },
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
