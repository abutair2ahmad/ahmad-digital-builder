<div class="page page--narrow section">
  <div style="max-width:420px">
    <h1 class="t-h2" style="margin-bottom:var(--s-6)">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="form__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="field">
        <span class="field__label">{{ 'customer.login.password' | t }}</span>
        <input class="input" type="password" name="customer[password]" autocomplete="new-password" required>
      </label>
      <button class="btn btn--full" type="submit" style="margin-top:var(--s-6)">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}{ "name": "Reset password", "tag": "div", "settings": [] }{% endschema %}
