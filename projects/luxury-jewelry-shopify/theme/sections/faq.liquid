{%- liquid assign s = section.settings -%}
<section class="section{% if s.background == 'alabaster' %} section--alabaster{% endif %}" style="--section-y: {{ s.spacing }}px">
  <div class="page">
    <div class="split" style="align-items:start">
      <div class="split__text">
        {%- if s.eyebrow != blank -%}<span class="t-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="t-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte t-lede">{{ s.text }}</div>{%- endif -%}
      </div>
      <div class="accordion">
        {%- for block in section.blocks -%}
          <details class="accordion__item" {{ block.shopify_attributes }}>
            <summary class="accordion__summary">
              <span style="text-transform:none;letter-spacing:0.01em;font-size:var(--t-body)">{{ block.settings.question }}</span>
              <span class="accordion__icon" aria-hidden="true"></span>
            </summary>
            <div class="accordion__panel rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you commission" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "alabaster", "label": "Alabaster" }
      ],
      "default": "paper"
    },
    { "type": "range", "id": "spacing", "min": 40, "max": 180, "step": 4, "unit": "px", "label": "Section spacing", "default": 112 }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does a commission take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Six to nine weeks from approved drawing to hallmark. Complex settings and sourced stones can add two to three weeks; we will tell you before you commit.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }, { "type": "qa" }] }
  ]
}
{% endschema %}
