{%- liquid
  assign s = section.settings
  assign use_rail = false
  if s.filter_style == 'rail' and collection.filters.size > 0
    assign use_rail = true
  endif
-%}
<div class="page">
  <nav class="crumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ collection.title }}</span>
  </nav>

  <header class="section section--tight section--flush-top" style="--section-y: var(--s-7)">
    <div class="coll-intro">
      {%- if s.eyebrow != blank -%}<span class="t-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      <h1 class="t-h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte t-lede">{{ collection.description }}</div>
      {%- elsif s.intro != blank -%}
        <div class="rte t-lede">{{ s.intro }}</div>
      {%- endif -%}
    </div>
  </header>

  <div class="coll-bar">
    <span class="coll-bar__count">
      {{ 'products.facets.count' | t: count: collection.products_count }}
    </span>
    <div class="coll-bar__tools">
      {%- if collection.filters.size > 0 -%}
        <button class="coll-bar__btn" type="button" data-drawer-open="filter-drawer" aria-controls="filter-drawer"
          {% if use_rail %}style="display:none" data-mobile-filters{% endif %}>
          {% render 'icon', name: 'filter' %}
          {{ 'products.facets.filter_and_sort' | t }}
        </button>
      {%- endif -%}
      {%- if collection.sort_options.size > 0 -%}
        <form class="coll-bar__sort-inline" data-facet-form>
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}
              <input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">
            {%- endfor -%}
          {%- endfor -%}
          <label class="visually-hidden" for="sort-desktop">{{ 'products.facets.sort_by' | t }}</label>
          <select id="sort-desktop" class="select" name="sort_by">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>
  </div>

  <div class="coll-layout{% if use_rail %} coll-layout--rail{% endif %}" style="padding-bottom: var(--s-9)">
    {%- if use_rail -%}
      <aside class="facets-rail">
        <form data-facet-form>
          <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
          {% render 'facets', filters: collection.filters %}
        </form>
      </aside>
    {%- endif -%}

    <div>
      {%- assign active_count = 0 -%}
      {%- for f in collection.filters -%}
        {%- assign active_count = active_count | plus: f.active_values.size -%}
      {%- endfor -%}
      {%- if active_count > 0 -%}
        <div class="active-facets">
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}
              <a class="active-facet" href="{{ v.url_to_remove }}">
                {{ v.label }} {% render 'icon', name: 'close' %}
              </a>
            {%- endfor -%}
          {%- endfor -%}
          <a class="active-facet" href="{{ collection.url }}">{{ 'products.facets.clear_all' | t }}</a>
        </div>
      {%- endif -%}

      {%- paginate collection.products by s.per_page -%}
        {%- if collection.products.size > 0 -%}
          <div class="grid grid--{{ s.columns }}">
            {%- for product in collection.products -%}
              {% render 'product-card', card_product: product, index: forloop.index,
                 sizes: '(min-width: 1100px) 22vw, (min-width: 750px) 30vw, 44vw' %}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p class="t-lede">{{ 'search.no_results' | t: terms: collection.title }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{%- if collection.filters.size > 0 -%}
  <div class="drawer drawer--right" id="filter-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'products.facets.filter_and_sort' | t }}">
    <div class="drawer__scrim" data-drawer-scrim></div>
    <div class="drawer__panel">
      <div class="drawer__head">
        <span class="drawer__title">{{ 'products.facets.filter_and_sort' | t }}</span>
        <button class="icon-btn" type="button" data-drawer-close data-autofocus aria-label="{{ 'general.accessibility.close' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
      </div>
      <form class="drawer__body" data-facet-form data-auto="false" id="filter-drawer-form">
        {%- if collection.sort_options.size > 0 -%}
          <div class="facet">
            <div class="facet__summary">{{ 'products.facets.sort_by' | t }}</div>
            <div class="facet__panel">
              <label class="visually-hidden" for="sort-drawer">{{ 'products.facets.sort_by' | t }}</label>
              <select id="sort-drawer" class="select" name="sort_by">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        {%- endif -%}
        {% render 'facets', filters: collection.filters, open_first: true %}
      </form>
      <div class="drawer__foot" style="display:grid;gap:var(--s-3)">
        <button class="btn btn--full" type="submit" form="filter-drawer-form">{{ 'products.facets.apply' | t }}</button>
        <a class="btn btn--ghost btn--full btn--sm" href="{{ collection.url }}">{{ 'products.facets.clear_all' | t }}</a>
      </div>
    </div>
  </div>
{%- endif -%}

<style>
  @media (max-width: 999px) { [data-mobile-filters] { display: inline-flex !important; } }
</style>

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "richtext", "id": "intro", "label": "Fallback intro", "info": "Used when the collection has no description." },
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 16 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "filter_style",
      "label": "Filters",
      "options": [
        { "value": "rail", "label": "Rail on desktop, drawer on mobile" },
        { "value": "drawer", "label": "Drawer everywhere" }
      ],
      "default": "rail"
    }
  ]
}
{% endschema %}
