{%- liquid
  assign s = section.settings
  assign light = false
  if s.layout == 'full' and s.text_color == 'light'
    assign light = true
  endif
-%}

{%- if s.layout == 'full' -%}
  <section class="hero hero--full">
    <div class="hero__media">
      {%- if s.image != blank or s.image_mobile != blank or s.fallback_image != blank -%}
        <picture>
          {%- if s.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 1200 }}">
          {%- elsif s.fallback_image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ s.fallback_image_mobile | asset_img_url: '1200x' }}">
          {%- endif -%}
          {% render 'responsive-image',
            image: s.image,
            fallback: s.fallback_image,
            alt: s.image_alt,
            sizes: '100vw',
            widths: '800,1200,1600,2000',
            loading: 'eager',
            fetchpriority: 'high',
            no_wrapper: true %}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="hero__overlay">
      {%- if light -%}<div class="hero__scrim"></div>{%- endif -%}
      <div class="page">
        <div class="hero__content{% if light %} hero__content--light{% endif %}">
          {%- if s.eyebrow != blank -%}<span class="t-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
          {%- if s.heading != blank -%}<h1 class="t-display">{{ s.heading }}</h1>{%- endif -%}
          {%- if s.text != blank -%}<p class="t-lede" style="max-width:44ch">{{ s.text }}</p>{%- endif -%}
          {%- if s.cta_label != blank or s.cta2_label != blank -%}
            <div class="hero__actions">
              {%- if s.cta_label != blank -%}
                <a class="btn{% if light %} btn--light{% endif %}" href="{{ s.cta_url | default: '#' }}">{{ s.cta_label }}</a>
              {%- endif -%}
              {%- if s.cta2_label != blank -%}
                <a class="btn {% if light %}btn--outline-light{% else %}btn--ghost{% endif %}" href="{{ s.cta2_url | default: '#' }}">{{ s.cta2_label }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

{%- else -%}
  <section class="hero hero--split">
    <div class="hero__grid{% if s.media_position == 'right' %} hero__grid--reverse{% endif %}">
      <div class="hero__pane-media">
        {% render 'responsive-image',
          image: s.image,
          fallback: s.fallback_image,
          alt: s.image_alt,
          sizes: '(min-width: 900px) 50vw, 100vw',
          widths: '600,800,1000,1400',
          loading: 'eager',
          fetchpriority: 'high',
          placeholder: 'lifestyle-1',
          no_wrapper: true %}
      </div>
      <div class="hero__pane-text">
        {%- if s.eyebrow != blank -%}<span class="t-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h1 class="t-h1">{{ s.heading }}</h1>{%- endif -%}
        {%- if s.text != blank -%}<p class="t-lede" style="max-width:40ch">{{ s.text }}</p>{%- endif -%}
        {%- if s.cta_label != blank or s.cta2_label != blank -%}
          <div class="hero__actions">
            {%- if s.cta_label != blank -%}<a class="btn" href="{{ s.cta_url | default: '#' }}">{{ s.cta_label }}</a>{%- endif -%}
            {%- if s.cta2_label != blank -%}<a class="btn btn--ghost" href="{{ s.cta2_url | default: '#' }}">{{ s.cta2_label }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full", "label": "Full-bleed cinematic" },
        { "value": "split", "label": "Split — image and type" }
      ],
      "default": "full"
    },
    { "type": "header", "content": "Imagery" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Art-direct the crop for portrait screens. Optional." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "A platinum solitaire ring worn on a hand resting on raw ivory silk" },
    { "type": "text", "id": "fallback_image", "label": "Bundled demo image", "info": "Theme asset filename used until a real image is uploaded.", "default": "cavelier-hero.jpg" },
    { "type": "text", "id": "fallback_image_mobile", "label": "Bundled demo image (mobile)", "default": "cavelier-hero-mobile.jpg" },
    { "type": "header", "content": "Type" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to order · London" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nothing is made until it is yours." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Engagement rings, wedding bands and fine jewellery, cut and set to commission in our Clerkenwell atelier." },
    {
      "type": "select",
      "id": "text_color",
      "label": "Overlay text colour",
      "options": [
        { "value": "light", "label": "Light on a scrim" },
        { "value": "dark", "label": "Dark (for pale imagery)" }
      ],
      "default": "light",
      "info": "Only applies to the full-bleed layout."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "info": "Only applies to the split layout."
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Engagement rings" },
    { "type": "url", "id": "cta_url", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Begin a bespoke commission" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Editorial hero" }]
}
{% endschema %}
