{%- liquid assign s = section.settings -%}
<article class="section">
  <div class="page page--narrow">
    <nav class="crumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a>
    </nav>

    <header class="article-hero" style="margin-block: var(--s-7) var(--s-8)">
      <span class="t-eyebrow">{{ article.tags.first | default: blog.title }}</span>
      <h1 class="t-h1" style="max-width:20ch">{{ article.title }}</h1>
      <div class="article-hero__meta">
        <span>{{ 'blogs.article.posted_on' | t: date: article.published_at | date: '%e %B %Y' }}</span>
        {%- if s.show_author and article.author != blank -%}
          <span aria-hidden="true">·</span>
          <span>{{ 'blogs.article.by' | t: author: article.author }}</span>
        {%- endif -%}
      </div>
    </header>
  </div>

  {%- if article.image -%}
    {%- assign hero_alt = article.image.alt | default: article.title -%}
    <div class="page">
      <div class="media media--wide">
        {% render 'responsive-image', image: article.image, alt: hero_alt,
           sizes: '100vw', widths: '800,1200,1600,2000', loading: 'eager', fetchpriority: 'high', no_wrapper: true %}
      </div>
    </div>
  {%- endif -%}

  <div class="page page--narrow" style="padding-top: var(--s-8)">
    <div class="rte prose {% if settings.prose_in_serif %}prose--serif{% endif %} mx-auto">
      {{ article.content }}
    </div>

    <div class="rule" style="margin-block: var(--s-8) var(--s-6)"></div>
    <a class="link-arrow" href="{{ blog.url }}">{{ 'blogs.article.back' | t }}</a>
  </div>

  {%- if blog.articles.size > 1 -%}
    <div class="page" style="padding-top: var(--s-9)">
      {% render 'section-header', heading: s.more_heading, heading_class: 't-h3' %}
      <div class="grid grid--3 grid--m1">
        {%- assign shown = 0 -%}
        {%- for a in blog.articles limit: 6 -%}
          {%- if a.id != article.id and shown < 3 -%}
            <a class="article-card" href="{{ a.url }}">
              <div class="article-card__media">
                {% render 'responsive-image', image: a.image, alt: a.title,
                   sizes: '(min-width: 750px) 32vw, 92vw', widths: '400,600,800', placeholder: 'image', no_wrapper: true %}
              </div>
              <div class="stack" style="--s-4: var(--s-2)">
                <h3 class="article-card__title">{{ a.title }}</h3>
              </div>
            </a>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "text", "id": "more_heading", "label": "More entries heading", "default": "More from the journal" }
  ]
}
{% endschema %}
