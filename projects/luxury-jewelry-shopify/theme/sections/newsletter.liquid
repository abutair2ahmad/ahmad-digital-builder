{%- liquid assign s = section.settings -%}
<section class="section{% if s.background == 'ink' %} section--ink{% elsif s.background == 'alabaster' %} section--alabaster{% endif %}" style="--section-y: {{ s.spacing }}px">
  <div class="page">
    <div class="split" style="align-items:end">
      <div class="split__text">
        {%- if s.eyebrow != blank -%}<span class="t-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="t-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte t-lede">{{ s.text }}</div>{%- endif -%}
      </div>
      <div>
        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form__success">{{ 'general.newsletter.success' | t }}</p>
          {%- else -%}
            <div class="newsletter__form" style="max-width:none">
              <label class="visually-hidden" for="news-{{ section.id }}">{{ 'general.newsletter.label' | t }}</label>
              <input class="input" id="news-{{ section.id }}" type="email" name="contact[email]"
                placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
              <button class="newsletter__submit" type="submit">{{ 'general.newsletter.submit' | t }}</button>
            </div>
            {%- if form.errors -%}<p class="form__error">{{ form.errors.messages.email }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
        {%- if s.note != blank -%}
          <p class="t-meta" style="margin-top:var(--s-4)">{{ s.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Letter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Eight letters a year, no more" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New work, stones we have found, and the occasional note from the bench.</p>" },
    { "type": "text", "id": "note", "label": "Small print", "default": "We do not share your address. Unsubscribe in one click." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "alabaster", "label": "Alabaster" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    },
    { "type": "range", "id": "spacing", "min": 40, "max": 180, "step": 4, "unit": "px", "label": "Section spacing", "default": 96 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
