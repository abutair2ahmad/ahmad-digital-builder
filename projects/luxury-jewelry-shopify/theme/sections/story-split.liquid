{%- liquid
  assign s = section.settings
-%}
<section class="section{% if s.background == 'alabaster' %} section--alabaster{% elsif s.background == 'ink' %} section--ink{% endif %}" style="--section-y: {{ s.spacing }}px">
  <div class="page">
    <div class="split{% if s.media_position == 'right' %} split--reverse{% endif %}{% if s.media_width == 'wide' %} split--wide-media{% endif %}{% if settings.enable_reveal %} reveal{% endif %}">
      <div class="split__media">
        {% render 'responsive-image',
          image: s.image,
          fallback: s.fallback_image,
          alt: s.image_alt,
          ratio: s.image_ratio,
          sizes: '(min-width: 900px) 50vw, 100vw',
          widths: '500,700,900,1200,1600',
          placeholder: 'lifestyle-2',
          wrapper_class: 'media__hover' %}
        {%- if s.caption != blank -%}
          <p class="t-meta" style="margin-top:var(--s-3)">{{ s.caption }}</p>
        {%- endif -%}
      </div>

      <div class="split__text">
        {%- if s.eyebrow != blank -%}<span class="t-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="t-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte t-lede">{{ s.text }}</div>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <dl class="stack" style="margin-top:var(--s-2)">
            {%- for block in section.blocks -%}
              <div class="accordion__row" {{ block.shopify_attributes }}>
                <dt>{{ block.settings.label }}</dt>
                <dd>{{ block.settings.value }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if s.cta_label != blank -%}
          <div>
            <a class="btn{% if s.background == 'ink' %} btn--light{% else %} btn--ghost{% endif %}" href="{{ s.cta_url | default: '#' }}">{{ s.cta_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story — image and text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "A goldsmith setting a diamond at the bench" },
    { "type": "text", "id": "fallback_image", "label": "Bundled demo image" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "portrait"
    },
    { "type": "text", "id": "caption", "label": "Image caption" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "Image width",
      "options": [
        { "value": "even", "label": "Even halves" },
        { "value": "wide", "label": "Wider image" }
      ],
      "default": "even"
    },
    { "type": "header", "content": "Type" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six weeks at a bench in Clerkenwell" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every CAVELIER piece is cut, set and finished by hand a few streets from Hatton Garden. Nothing is cast speculatively and nothing sits in a drawer waiting for a buyer.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "alabaster", "label": "Alabaster" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "paper"
    },
    { "type": "range", "id": "spacing", "min": 40, "max": 180, "step": 4, "unit": "px", "label": "Section spacing", "default": 112 }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification row",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Metal" },
        { "type": "text", "id": "value", "label": "Value", "default": "18k gold, platinum" }
      ]
    }
  ],
  "presets": [{ "name": "Story — image and text" }]
}
{% endschema %}
