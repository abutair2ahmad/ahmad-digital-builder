{%- comment -%} Inline SVG icons. Hairline weight to match the type. {%- endcomment -%}
{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false"><circle cx="8.6" cy="8.6" r="5.6"/><path d="M12.8 12.8 17.5 17.5"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false"><circle cx="10" cy="6.6" r="3.4"/><path d="M3.4 17.2c.6-3.4 3.3-5.2 6.6-5.2s6 1.8 6.6 5.2"/></svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false"><path d="M4.2 6.4h11.6l-.9 10.4H5.1z"/><path d="M7.4 6.4V5.2a2.6 2.6 0 0 1 5.2 0v1.2"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false"><path d="M2.5 6.5h15M2.5 13.5h15"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false"><path d="M5 5l10 10M15 5L5 15"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M6 1v10M1 6h10"/></svg>
  {%- when 'minus' -%}
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M1 6h10"/></svg>
  {%- when 'filter' -%}
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M0 2.5h12M2.5 6h7M4.5 9.5h3"/></svg>
  {%- when 'arrow' -%}
    <svg viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M0 6h15M10 1l5 5-5 5"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false"><rect x="3" y="3" width="14" height="14" rx="4"/><circle cx="10" cy="10" r="3.4"/><circle cx="14.4" cy="5.6" r=".9" fill="currentColor" stroke="none"/></svg>
  {%- when 'pinterest' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.2"/><path d="M8.4 16.6c.9-2.6 1.4-4.6 1.4-4.6M7.9 8.4c0-1.5 1.1-2.6 2.5-2.6 1.5 0 2.5 1 2.5 2.5 0 1.9-1 3.3-2.4 3.3-.8 0-1.4-.6-1.2-1.4"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.2"/><path d="M11.9 7.1h-1.1c-.6 0-1 .4-1 1v8.9M8.3 10.6h3.3"/></svg>
