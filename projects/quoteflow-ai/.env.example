# ---------------------------------------------------------------------------
# QuoteFlow AI — environment
#
# With NOTHING set, the app runs in local demo mode: embedded Postgres under
# .data/, cookie-session auth, uploads on disk, a guided (non-LLM) assistant,
# and a seeded demo company (demo@quoteflow.ai / demo1234).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (all three switch the app to Supabase mode) -------------------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project settings → Database → connection string (session or transaction pooler)
DATABASE_URL=
# Needed for file uploads (private bucket, server-side) and for `npm run db:seed`
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- AI assistant ------------------------------------------------------------
# Without a key the public page uses the deterministic guided flow.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Local mode only ---------------------------------------------------------
# Secret for signing session cookies (auto-generated into .data/ if empty)
AUTH_SECRET=
# Where the embedded database and uploads live
QUOTEFLOW_DATA_DIR=.data
# Set to false to boot with an empty database instead of the demo company
QUOTEFLOW_SEED_DEMO=true

# ---------------------------------------------------------------------------
# Production (Vercel) checklist — every one of these must be set:
#   NEXT_PUBLIC_APP_URL          https://<your-domain>
#   NEXT_PUBLIC_SUPABASE_URL     https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY    (server-side only — never exposed to the browser)
#   DATABASE_URL                 Supabase pooler connection string
#   SUPABASE_STORAGE_BUCKET      uploads
#   ANTHROPIC_API_KEY            enables the real AI agent
# ---------------------------------------------------------------------------
