{
  "name": "quoteflow-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db-seed.ts",
    "storage:setup": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/storage-setup.ts",
    "verify:prod": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-production.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "QuoteFlow AI \u2014 AI lead qualification, deterministic pricing rules, quotes with PDF proposals and a lightweight CRM for service businesses."
}
