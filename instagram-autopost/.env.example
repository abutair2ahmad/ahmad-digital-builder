# Instagram auto-publisher — variable NAMES only. Real values live in the project
# .env, which is git-ignored. Never commit a populated copy of this file.

# --- Instagram accounts. One isolated pair per brand; they are never interchanged.
INSTAGRAM_MOVEWELL_IG_ID=
INSTAGRAM_MOVEWELL_TOKEN=
INSTAGRAM_BYNEXORA_IG_ID=
INSTAGRAM_BYNEXORA_TOKEN=

# --- Master switch. Anything other than true/1/yes/on means dry run: content is
#     generated and checked, but nothing is sent to Instagram.
IG_PUBLISH_ENABLED=false

# --- Graph host. graph.instagram.com for Instagram API with Instagram Login
#     (the current setup); graph.facebook.com if the accounts are published
#     through a linked Facebook Page instead.
INSTAGRAM_GRAPH_HOST=graph.instagram.com

# --- Image hosting. Instagram fetches the image itself from a public HTTPS URL,
#     so rendered files must be uploaded somewhere reachable before publishing.
IMAGE_HOST=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Only for the 'local' image backend, used in testing.
# IMAGE_HOST=local
# IMAGE_LOCAL_DIR=
# IMAGE_PUBLIC_BASE_URL=
