# MoveWell Instagram publisher — local configuration
#
# Copy this file to .env in the same folder and fill in the two blank values.
# .env is gitignored. Never commit it, never paste its contents into a chat.
#
#   cp .env.example .env
#
# These credentials belong to @movewell.il only. Keep them out of any file,
# vault entry or app that also holds NEXORA / bynexora.co credentials.

# ---- required -------------------------------------------------------------

# Instagram User access token issued by Instagram Login for @movewell.il.
# Needs the scopes: instagram_business_basic, instagram_business_content_publish
IG_ACCESS_TOKEN=

# The Instagram user id for @movewell.il.
# Optional but recommended: when set, the account guard cross-checks it against
# the id the token resolves to and aborts on any mismatch.
IG_USER_ID=

# ---- safety defaults — change only when you intend to publish --------------

# true  = rehearse everything, send nothing (default, and the default when unset)
# false = allow live publishing, but --confirm on the command line is still required
DRY_RUN=true

# The only account this tool will publish to. The account guard refuses to run
# if the token resolves to anything else.
IG_TARGET_USERNAME=movewell.il

# ---- rarely changed -------------------------------------------------------

# Instagram Login talks to graph.instagram.com. The tool refuses any other host.
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v23.0

REQUEST_TIMEOUT_MS=30000
