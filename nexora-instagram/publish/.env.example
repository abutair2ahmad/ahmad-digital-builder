# NEXORA → Instagram publisher
#
# Copy this file to publish/.env and fill it in. That file is gitignored and
# must never be committed. Nothing here belongs in the code or on GitHub.

# ---- required to publish -----------------------------------------------

# Long-lived Instagram/Facebook user access token (60 days) or a System User
# token (does not expire). Never share it, never paste it into an issue or PR.
IG_ACCESS_TOKEN=

# The Instagram *professional account* id for @bynexora.co.
# This is NOT the numeric id you see in the app, and NOT the Facebook Page id.
# Get it with:
#   GET https://graph.facebook.com/v23.0/me/accounts?access_token=...
#   GET https://graph.facebook.com/v23.0/<page-id>?fields=instagram_business_account&access_token=...
IG_USER_ID=

# Public HTTPS base URL that serves out/nexora-post-NN.png.
# Meta fetches the image from this URL itself — a local file path cannot work.
# This repo is public, so the pushed branch already serves them:
IG_IMAGE_BASE_URL=https://raw.githubusercontent.com/abutair2ahmad/ahmad-digital-builder/claude/nexora-instagram-content-aey3ur/nexora-instagram/out

# ---- safety ------------------------------------------------------------

# true  = validate and print everything, publish nothing  (default)
# false = actually publish
DRY_RUN=true

# The script aborts if IG_USER_ID resolves to any other handle.
IG_EXPECTED_USERNAME=bynexora.co

# ---- optional ----------------------------------------------------------

# Graph API version. Bump when Meta deprecates one.
IG_API_VERSION=v23.0

# Skip the "is the image URL public" pre-check. Leave false.
SKIP_URL_CHECK=false

# Pause between posts when running --all, in milliseconds.
POST_GAP_MS=60000
